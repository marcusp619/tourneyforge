# Database
DATABASE_URL=

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend Email
RESEND_API_KEY=

# Platform
PORT=3001

# ── Auth (the tenant boundary) ────────────────────────────────────────────────
# LOCAL_DEV=true assumes a fixed identity so the offline stack works without Clerk.
# The tenant is still resolved from tenant_members — never from the request.
# Refused when NODE_ENV=production.
LOCAL_DEV=
LOCAL_DEV_USER_ID=
