# TourneyForge environment variables.
#
# You probably do not need to fill this in. For local development use the docker stack
# instead — it needs no cloud accounts and no keys:
#
#   cp apps/web/.env.local.docker apps/web/.env.local
#   cp packages/api/.env.docker    packages/api/.env
#   cp packages/db/.env.docker     packages/db/.env
#   pnpm dev:up
#
# Those three tracked templates already contain working values for postgres, redis,
# MinIO and Mailpit. This file is for a real cloud deployment only.

# Database (Neon PostgreSQL)
DATABASE_URL=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 (File Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend Email
RESEND_API_KEY=

# Platform
NEXT_PUBLIC_ROOT_DOMAIN=tourneyforge.com
NEXT_PUBLIC_API_URL=http://localhost:3001
