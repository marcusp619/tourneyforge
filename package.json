{
  "name": "tourneyforge",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:push": "cd packages/db && bun run push",
    "db:migrate": "cd packages/db && bun run migrate",
    "db:generate": "cd packages/db && bun run generate",
    "db:studio": "cd packages/db && bun run studio",
    "db:seed": "cd packages/db && bun run seed",
    "dev:up": "bash scripts/dev-up.sh",
    "test:e2e": "pnpm --filter @tourneyforge/web test:e2e"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "prettier": "^3.5.2",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4"
    }
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
